{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O3",
                "-Wa,-mbig-obj",              // <--- ИСПРАВЛЕНО: Теперь с большой буквы W
                "${fileDirname}\\\\*.cpp",
                "-o",
                "${fileDirname}\\\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true             // Эта задача главная
            },
            "detail": "Task generated by Debugger."
        }
    ]
}